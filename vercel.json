{
  "rewrites": [
    {
      "source": "/:lang(fr|es|zh|en)/help",
      "destination": "/:lang/help.html"
    },
    {
      "source": "/:lang(fr|es|zh|en)",
      "destination": "/:lang.html"
    },
    {
      "source": "/:lang(fr|es|zh|en)/:rest(.*)",
      "destination": "/:lang.html"
    }
  ]
}
